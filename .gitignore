# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS junk ---
Thumbs.db
.DS_Store
desktop.ini

# --- SteamPad Bridge runtime output ---
# Diagnostic captures and frame dumps the GUI writes
capture_*.txt
frames_dump.txt
first_frames.txt

# Per-machine settings (saved HID interface path, etc.)
profiles/_settings.json

# Logs
*.log

# --- PyInstaller build artifacts ---
build/
dist/
*.manifest
# Keep the canonical SteamPadBridge.spec checked in (it's our build recipe);
# ignore PyInstaller's auto-generated spec files for one-off invocations.
*.spec
!SteamPadBridge.spec
